<UserControl x:Class="WeLinkMessageExporter.Controls.DarkDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="175" Height="39"
             FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid x:Name="DateRoot">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="DateInput" Grid.Column="0" VerticalContentAlignment="Center"
                 Padding="11,7" Margin="0,0,5,0" ToolTip="输入 YYYY-MM-DD 或点击右侧按钮选择日期"
                 KeyDown="DateInput_KeyDown" LostKeyboardFocus="DateInput_LostKeyboardFocus"
                 TextChanged="DateInput_TextChanged"/>
        <Button x:Name="OpenCalendarButton" Grid.Column="1" Width="40" Padding="2" FontSize="19"
                Content="▦" ToolTip="选择日期" Click="OpenCalendar_Click"
                Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}"/>
        <primitives:Popup x:Name="CalendarPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=DateRoot}"
                          HorizontalOffset="0" VerticalOffset="5" StaysOpen="False"
                          AllowsTransparency="True" PopupAnimation="Fade" Opened="CalendarPopup_Opened">
            <Border Width="321" Background="{StaticResource PanelRaisedBrush}" CornerRadius="13"
                    BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                    Padding="13,12" SnapsToDevicePixels="True">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="PreviousMonthButton" Grid.Column="0" Content="‹" Width="36" Height="32"
                                Style="{StaticResource CalendarNavButtonStyle}" Click="PreviousMonth_Click"/>
                        <TextBlock x:Name="MonthTitle" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <Button x:Name="NextMonthButton" Grid.Column="2" Content="›" Width="36" Height="32"
                                Style="{StaticResource CalendarNavButtonStyle}" Click="NextMonth_Click"/>
                    </Grid>
                    <primitives:UniformGrid x:Name="WeekdaysGrid" Columns="7" Rows="1" Margin="0,0,0,5"/>
                    <primitives:UniformGrid x:Name="DaysGrid" Columns="7" Rows="6"/>
                    <Border Height="1" Background="{StaticResource InputBorderBrush}" Margin="2,9"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="周一为每周首日" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="今天" Padding="13,6" Click="Today_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </primitives:Popup>
    </Grid>
</UserControl>
